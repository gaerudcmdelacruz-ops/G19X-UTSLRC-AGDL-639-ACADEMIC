# Copia este archivo como ".env" y completa los valores. NUNCA compartas el .env.
JWT_SECRET=una-frase-larga-y-unica

# ---- IA (Paso D). Basta con UNA de las dos claves ----
# Gemini (Google) - tiene capa gratuita. Clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash        (si se acaba el límite gratis: gemini-3.5-flash-lite)

# Claude (Anthropic) - de pago. Clave en https://console.anthropic.com
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-5-5

# Si tienes las dos claves, elige cuál usar: gemini o claude (por defecto, Gemini)
# IA_PROVEEDOR=gemini

# Modo demo: permite a Administrador/Supervisor registrar un mensaje COMO el cliente (para probar sin canales reales). 1 = activo
# MODO_DEMO=1
