# Copia este archivo como ".env" y completa los valores. NUNCA compartas el .env.
JWT_SECRET=una-frase-larga-y-unica

# ---- IA. Basta con UNA de las dos claves ----
# Gemini (Google) - tiene capa gratuita. Clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash        (si se acaba el límite gratis: gemini-3.5-flash-lite)

# Claude (Anthropic) - de pago. Clave en https://console.anthropic.com
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-5-5

# Si tienes las dos claves, elige cuál usar: gemini o claude (por defecto, Gemini)
# IA_PROVEEDOR=gemini

# ---- Servicio de IA en Python (FastAPI, carpeta ia-python) - OPCIONAL ----
# Si la defines, el backend ya no habla directo con Gemini/Claude: le pasa el análisis al servicio Python.
# El servicio lee las claves de este mismo .env. Sin esta línea, todo funciona como antes (Node directo).
# IA_SERVICIO_URL=http://localhost:8000
# Clave compartida entre Node y Python (opcional; si la pones, debe estar igual en ia-python/.env)
# IA_SERVICIO_CLAVE=

# Modo demo: permite a Administrador/Supervisor registrar un mensaje COMO el cliente (para probar sin canales reales). 1 = activo
# MODO_DEMO=1
